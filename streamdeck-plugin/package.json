{
  "name": "stream-state-router-streamdeck",
  "version": "2.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "typecheck": "tsc --noEmit",
    "validate": "streamdeck validate com.remyducros.streamstaterouter.sdPlugin --no-update-check",
    "pack": "streamdeck pack com.remyducros.streamstaterouter.sdPlugin --no-update-check --force"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.0.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.7.1",
    "@tsconfig/node20": "^20.1.2",
    "@types/node": "^20.19.0",
    "rolldown": "^1.0.0-rc.6",
    "typescript": "^5.2.2"
  }
}
